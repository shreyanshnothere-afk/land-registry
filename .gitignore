# ==============================================================
# TerraLedger — Land Registry dApp on Stellar Soroban
# .gitignore — Root-level (applies to all subdirectories)
# ==============================================================

# ── Node / JavaScript ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Next.js ────────────────────────────────────────────────────
.next/
out/
build/

# ── Rust / Soroban (Stellar smart contracts) ───────────────────
target/
Cargo.lock           # optional: keep for reproducible builds; remove this line if preferred

# ── Environment / Secrets ──────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
secrets/

# ── TypeScript ─────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── macOS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Windows ────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors / IDEs ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ───────────────────────────────────────────────────────
*.log
.cache/
.parcel-cache/
dist/
coverage/
.nyc_output/
